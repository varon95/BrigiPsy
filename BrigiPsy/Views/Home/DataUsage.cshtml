@{
    ViewData["Title"] = "Adatkezelési Tájékoztató";
}

<div class="container my-5">
        <h2>Adatkezelési Tájékoztató</h2>

        <section>
            <h3>Adatkezelő Megnevezése</h3>
            <p><strong>Név:</strong> Gyomlai Gábor e.v.</p>
            <p><strong>Székhely:</strong> 4400 Nyíregyháza, Család u. 104/d</p>
            <p>Adatvédelmi kérelmeket postai úton a fenti címre lehet küldeni. Válasz legfeljebb 30 napon belül érkezik.</p>
        </section>

        <section>
            <h3>Kezelt Adatok Köre és Adatkezelés Céljai</h3>
            <p>Az adatkezelés minden vonatkozó jogszabálynak megfelel. Az Adatkezelő elkötelezett az ügyfelek személyes adatainak védelme mellett.</p>

            <h4>Adatkezelés céljai:</h4>
            <ul>
                <li>Kapcsolatfelvétel (elektronikus, telefonos, postai)</li>
                <li>Pszichológiai szolgáltatás teljesítése</li>
                <li>Könyvvezetési és adózási kötelezettségek teljesítése</li>
            </ul>
        </section>

        <section>
            <h3>Adatkezelés Jogalapjai</h3>
            <ul>
                <li>Számviteli jogszabályoknak megfelelő számla kiállítása: GDPR 6. cikk (1) c</li>
                <li>Kapcsolattartás: GDPR 6. cikk (1) f</li>
                <li>Szerződés teljesítése: GDPR 6. cikk (1) b</li>
                <li>Hozzájárulás (online regisztráció): GDPR 6. cikk (1) a</li>
            </ul>
        </section>

        <section>
            <h3>Adatkezelés Időtartama</h3>
            <p><strong>Számlák:</strong> 8 év</p>
            <p><strong>Kapcsolattartási adatok:</strong> kapcsolat megszűnését követően 1 év</p>
            <p><strong>Szerződéshez kapcsolódó adatok:</strong> szerződés megszűnését követően 5 év</p>
        </section>

        <section>
            <h3>Jogorvoslati Lehetőség</h3>
            <p>Panasszal fordulhat az adatkezelőhöz, illetve a Nemzeti Adatvédelmi és Információszabadság Hatósághoz (NAIH).</p>
            <address>
                <strong>NAIH:</strong><br>
                Székhely: 1125 Budapest, Szilágyi Erzsébet fasor 22/C.<br>
                Telefon: +36 1 391 1400
            </address>
        </section>
</div>
