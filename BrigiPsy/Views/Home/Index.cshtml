@model BrigiPsy.Models.ContactFormModel
@{
    ViewData["Title"] = "Főoldal";
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<!-- Rólam Section -->
<section id="rolam" class="section">
    <div class="container">
        <!-- Subsection a -->
        <div class="d-flex flex-column flex-md-row align-items-center justify-content-start mb-5">
            <div class="text-center mb-3 mb-md-0">
                <img src="~/images/VaradiBorbasBrigitta.webp" class="img-fluid rounded-circle" alt="Váradi-Borbás Brigitta fényképe" style="max-width: 250px; border: 3px solid #F3EDE0;" />
            </div>
            <div class="ms-md-4 text-center text-md-start">
                <h2 class="section-title">Váradi-Borbás Brigitta</h2>
                <h3>Pszichológus</h3>
            </div>
        </div>
        <!-- Subsection b -->
        <div class="row">
            <div class="col-md-6 order-md-2">
                <img src="~/images/img1.webp" class="img-fluid" alt="Kép" />
            </div>
            <div class="col-md-6 order-md-1">
                <!-- About Me Content -->
                <div style="font-family: forum, serif; font-size: 18px;">
                    <!-- About Me Content -->
                    <div style="font-family: forum, serif; font-size: 18px;">
                        <p>Váradi-Borbás Brigitta okleveles pszichológus, CBT konzultáns jelölt vagyok. Tanulmányaimat Hollandiában, a Maastrichti Egyetemen végeztem, ahol a pszichológia legmodernebb irányzatait, eredményeit ismerhettem meg. Itt találkoztam a kognitív viselkedésterápia módszerével is, amelyben jelenleg is képződöm.</p>
                        <p>Munkámat elsősorban a személyközpontú segítő beszélgetés elemei határozzák meg: az empátia, a feltétel nélküli pozitív elfogadás és a hitelesség, mely minden segítő kapcsolat alapja. Az ülések során az adott kliens szükségleteihez igazítva relaxációs módszereket, asszociációs kártyákat (OH kártya), és pszichoedukációs gyakorlatokat is alkalmazok.</p>
                        <p>​A magas minőségű szakmai munka érdekében rendszeresen részt veszek szupervíziós alkalmakon, valamint önismereti csoporton.</p>
                        <p>Legfőbb szakmai tapasztalatom a hódmezővásárhelyi EVP-Egészségfejlesztési Irodában szereztem, ahol a legkülönfélébb problémákkal kerestek meg a fiatal felnőtt korosztálytól kezdve az időskorú páciensekig. Emellett az aggódás, rágódás kezelésére, az önegyüttérzés fejlesztésére irányuló tréningeket is kidolgoztam, tartottam, az egyes gyakorlatokat, technikákat egyéni tanácsadás keretein belül is szívesen alkalmazom.</p>
                        <p>Később óvodapszichológusként gyerekekkel, szülőkkel és pedagógusokkal egyaránt dolgoztam.</p>
                    </div>

                </div>
            </div>
        </div>
    </div>
</section>

<!-- Szakterületeim Section -->
<section id="szakteruleteim" class="section">
    <div class="container">
        <div class="row">
            <div class="col-md-6">
                <img src="~/images/img2.webp" class="img-fluid" alt="Kép" />
            </div>
            <div class="col-md-6">
                <!-- Experiences Content -->
                <div style="font-family: forum, serif; font-size: 18px;">
                    <!-- Experiences Content -->
                    <div class="text-center">
                        <h2 style="font-family: forum, serif;">Miben segíthetek?</h2>
                        <h6 style="font-family: forum, serif;">Egyéni pszichológiai konzultáció</h6>
                        <hr>
                    </div>

                    <ul class="list-unstyled" style="font-family: forum, serif; font-size: 18px;">
                        <li class="mb-2">Stresszkezelés, indulatkezelés</li>
                        <li class="mb-2">Rágódás, aggódás kezelése</li>
                        <li class="mb-2">Magány leküzdése</li>
                        <li class="mb-2">Önbizalomerősítés</li>
                        <li class="mb-2">Önérvényesítés, kommunikáció fejlesztése</li>
                        <li class="mb-2">Szülői lét nehézségeinek kezelése</li>
                        <li class="mb-2">Megváltozott élethelyzettel való megküzdés</li>
                        <li class="mb-2">Munka-magánélet egyensúly megteremtése</li>
                        <li class="mb-2">Személyes motiváció megtalálása</li>
                        <li class="mb-2">Mentális egészség, önismeret fejlesztése</li>
                    </ul>

                </div>
            </div>
        </div>
    </div>
</section>

<!-- Árak Section -->
<section id="arak" class="section">
    <div class="container">
        <div class="row">
            <div class="col-md-6 order-md-2">
                <img src="~/images/img3.webp" class="img-fluid" alt="Kép" />
            </div>
            <div class="col-md-6 order-md-1">
                <!-- Prices Content -->
                <div style="font-family: forum, serif; font-size: 18px;">
                    <!-- Prices Content -->
                    <div class="text-center mb-4" style="font-family: forum, serif;">
                        <p class="fw-bold" style="font-size: 25px; font-style: italic;">Egyéni pszichológiai konzultáció</p>
                        <p style="font-size: 25px;">12.000 Ft/50 perc</p>
                    </div>

                    <div class="text-center mb-4" style="font-family: forum, serif;">
                        <p class="fw-bold" style="font-size: 25px; font-style: italic;">Kedvezményes ár</p>
                        <p style="font-size: 18px; font-style: italic;">(diákoknak, GYES/GYED-en lévő szülőknek, egyedülálló szülőknek, nyugdíjasoknak, munkanélkülieknek)</p>
                        <p style="font-size: 25px;">9.000 Ft/50 perc</p>
                    </div>

                </div>
            </div>
        </div>
    </div>
</section>

<!-- Kapcsolat Section -->
<section id="kapcsolat" class="section">
    <div class="container">
        <div class="row">
            <div class="col-md-6">
                <img src="~/images/img4.webp" class="img-fluid" alt="Kép" />
            </div>
            <div class="col-md-6">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success">@TempData["Success"]</div>
                }
                else
                {
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                }
                <div class="text-center mb-4">
                    <h2 style="font-size:26px; font-family: forum, serif;">Lépjen velem kapcsolatba</h2>
                    <hr>
                </div>

                <div style="font-size:16px;">
                    <p>Ha kérdése van, vagy szeretne hozzám bejelentkezni, keressen bizalommal az alábbi elérhetőségeken.</p>
                    <p>Egry József utca 19, Fsz 5<br>Budapest, 1111</p>
                    <p><a href="mailto:varadiborbasbrigitta@gmail.com">varadiborbasbrigitta@gmail.com</a></p>
                    <p>Telefon: +36-20-488-2585</p>
                </div>

                <form asp-action="Contact" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Message" class="form-label"></label>
                        <textarea asp-for="Message" class="form-control" rows="5"></textarea>
                        <span asp-validation-for="Message" class="text-danger"></span>
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" asp-for="AcceptPrivacyPolicy" required="required"
                               data-val="true"
                               data-val-required="Az adatkezelési nyilatkozat elfogadása kötelező." />
                        <label class="form-check-label" for="AcceptPrivacyPolicy">
                            Adatkezelési nyilatkozatot elolvastam és elfogadom. Megtekinthető
                            <a href="@Url.Action("DataUsage", "Home")">itt</a>.
                        </label>
                        <span asp-validation-for="AcceptPrivacyPolicy" class="text-danger"></span>
                    </div>


                    <button type="submit" class="btn btn-primary">Üzenet elküldése</button>
                </form>
            </div>
        </div>
    </div>
</section>




@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
