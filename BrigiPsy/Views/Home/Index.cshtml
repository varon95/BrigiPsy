@model BrigiPsy.Models.ContactFormModel
@{
    ViewData["Title"] = "Főoldal";
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<!-- Rólam Section -->
<section id="rolam" class="section">
    <div class="container">
        <!-- Subsection a -->
        <div class="d-flex flex-column flex-md-row align-items-center justify-content-start mb-5">
            <div class="text-center mb-3 mb-md-0">
                <img src="~/images/VaradiBorbasBrigitta.webp" class="img-fluid rounded-circle" alt="Váradi-Borbás Brigitta fényképe" style="max-width: 250px; border: 3px solid #F3EDE0;" />
            </div>
            <div class="ms-md-4 text-center text-md-start">
                <h2 class="section-title">Váradi-Borbás Brigitta</h2>
                <h3>Pszichológus</h3>
            </div>
        </div>
        <!-- Subsection b -->
        <div class="row">
            <div class="col-md-6 order-md-2">
                <img src="~/images/img1.webp" class="img-fluid" alt="Kép" />
            </div>
            <div class="col-md-6 order-md-1">
                <!-- About Me Content -->
                <div style="font-family: forum, serif; font-size: 18px;">
                    <!-- About Me Content -->
                    <div style="font-family: forum, serif; font-size: 18px;">
                        <p>Váradi-Borbás Brigitta pszichológus vagyok, egyéni pszichológiai konzultációt kínálok Budapest 11. kerületében, valamint online.</p>
                        <p>Tanulmányaimat Hollandiában, a Maastrichti Egyetemen végeztem, ahol lehetőségem volt megismerni a pszichológia legmodernebb irányzatait. A kognitív viselkedésterápiával is itt találkoztam, melyben jelenleg is képződöm.</p>
                        <p>Munkámat a személyközpontú segítő beszélgetés elemei – empátia, feltétel nélküli pozitív elfogadás és hitelesség – határozzák meg. Az üléseken a kliens szükségleteihez igazodva autogén tréninget, asszociációs kártyákat, és pszichoedukációs gyakorlatokat is alkalmazok.</p>
                        <p>A legtöbb szakmai tapasztalatomat a hódmezővásárhelyi EVP-Egészségfejlesztési Irodában szereztem, ahol különféle problémákkal fordultak hozzám fiatal felnőttek és időskorúak egyaránt. Emellett óvodapszichológusként gyerekekkel, szülőkkel és pedagógusokkal dolgoztam.</p>
                        <p>Jelenleg felnőtt klienseket fogadok. A szakmai minőség biztosítása érdekében rendszeresen részt veszek szupervíziós és önismeretfejlesztő csoportokon.</p>
                    </div>

                </div>
            </div>
        </div>
    </div>
</section>

<!-- Szakterületeim Section -->
<section id="szakteruleteim" class="section">
    <div class="container">
        <div class="row">
            <div class="col-md-6">
                <img src="~/images/img2.webp" class="img-fluid" alt="Kép" />
            </div>
            <div class="col-md-6">
                <!-- Experiences Content -->
                <div style="font-family: forum, serif; font-size: 18px;">
                    <!-- Experiences Content -->
                    <div class="text-center">
                        <h2 style="font-family: forum, serif;">Miben segíthetek?</h2>
                        <h6 style="font-family: forum, serif;">Egyéni pszichológiai konzultáció</h6>
                        <hr>
                    </div>

                    <ul class="list-unstyled" style="font-family: forum, serif; font-size: 18px;">
                        <li class="mb-2">Stresszkezelés, indulatkezelés</li>
                        <li class="mb-2">Rágódás, aggódás kezelése</li>
                        <li class="mb-2">Magány leküzdése</li>
                        <li class="mb-2">Önbizalomerősítés</li>
                        <li class="mb-2">Önérvényesítés, kommunikáció fejlesztése</li>
                        <li class="mb-2">Szülői lét nehézségeinek kezelése</li>
                        <li class="mb-2">Megváltozott élethelyzettel való megküzdés</li>
                        <li class="mb-2">Munka-magánélet egyensúly megteremtése</li>
                        <li class="mb-2">Személyes motiváció megtalálása</li>
                        <li class="mb-2">Mentális egészség, önismeret fejlesztése</li>
                    </ul>

                </div>
            </div>
        </div>
    </div>
</section>

<!-- Árak Section -->
<section id="arak" class="section">
    <div class="container">
        <div class="row">
            <div class="col-md-6 order-md-2">
                <img src="~/images/img3.webp" class="img-fluid" alt="Kép" />
            </div>
            <div class="col-md-6 order-md-1">
                <!-- Prices Content -->
                <div style="font-family: forum, serif; font-size: 18px;">
                    <!-- Prices Content -->
                    <div class="text-center mb-4" style="font-family: forum, serif;">
                        <p class="fw-bold" style="font-size: 25px; font-style: italic;">Egyéni pszichológiai konzultáció</p>
                        <p style="font-size: 25px;">12.000 Ft/50 perc</p>
                    </div>

                    <div class="text-center mb-4" style="font-family: forum, serif;">
                        <p class="fw-bold" style="font-size: 25px; font-style: italic;">Kedvezményes ár</p>
                        <p style="font-size: 18px; font-style: italic;">(diákoknak, GYES/GYED-en lévő szülőknek, egyedülálló szülőknek, nyugdíjasoknak, munkanélkülieknek)</p>
                        <p style="font-size: 25px;">9.000 Ft/50 perc</p>
                    </div>

                </div>
            </div>
        </div>
    </div>
</section>

<!-- Kapcsolat Section -->
<section id="kapcsolat" class="section">
    <div class="container">
        <div class="row">
            <div class="col-md-6">
                <img src="~/images/img4.webp" class="img-fluid" alt="Kép" />
            </div>
            <div class="col-md-6">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success">@TempData["Success"]</div>
                }
                <div class="text-center mb-4">
                    <h2 style="font-size:26px; font-family: forum, serif;">Lépjen velem kapcsolatba</h2>
                    <hr>
                </div>

                <div style="font-size:16px;">
                    <p>Ha kérdése van, vagy szeretne hozzám bejelentkezni, keressen bizalommal az alábbi elérhetőségeken.</p>
                    <p>Egry József utca 19, Fsz 5<br>Budapest, 1111</p>
                    <p><a href="mailto:varadiborbasbrigitta@gmail.com">varadiborbasbrigitta@gmail.com</a></p>
                    <p>Telefon: +36-20-488-2585</p>
                </div>
                <form asp-action="Contact" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label for="Name" class="form-label">Név</label>
                        <input type="text" class="form-control" id="Name" name="Name" value="@Model.Name" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label for="Email" class="form-label">Email</label>
                        <input type="email" class="form-control" id="Email" name="Email" value="@Model.Email" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label for="Message" class="form-label">Üzenet</label>
                        <textarea class="form-control" id="Message" name="Message" rows="5">@Model.Message</textarea>
                        <span asp-validation-for="Message" class="text-danger"></span>
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="AcceptPrivacyPolicy" name="AcceptPrivacyPolicy" value="true" @(Model.AcceptPrivacyPolicy ? "checked" : "") />
                        <label class="form-check-label" for="AcceptPrivacyPolicy">
                            Adatkezelési nyilatkozatot elolvastam és elfogadom. Megtekinthető <a href="/Home/DataUsage">itt</a>.
                        </label>
                        <span asp-validation-for="AcceptPrivacyPolicy" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-primary">Üzenet elküldése</button>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
