@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@model BrigiPsy.Models.ContactFormModel
@{
    ViewData["Title"] = "Váradi-Borbás Brigitta - Pszichológus és pszichológiai szakfordító Budapesten | Főoldal";
    var cspNonce = Context.Items["CspNonce"] as string;
    var recaptchaSiteKey = Configuration["Recaptcha:SiteKey"];
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<!-- Meta Tags -->
<link rel="canonical" href="https://www.borbasbrigitta.com/" />
<meta name="description" content="Váradi-Borbás Brigitta pszichológus és pszichológiai szakfordító Budapesten. Egyéni pszichológiai konzultáció, fóbiák, szorongás, rágódás, perfekcionizmus és más nehézségek támogatása." />
<meta name="robots" content="index, follow" />

<!-- Structured Data -->
<script nonce="@cspNonce" type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "LocalBusiness",
      "name": "Váradi-Borbás Brigitta",
      "url": "https://www.borbasbrigitta.com",
      "image": "https://www.borbasbrigitta.com/images/VaradiBorbasBrigitta.webp",
      "description": "Pszichológus és pszichológiai szakfordító Budapesten, egyéni pszichológiai konzultációval és angol–magyar szakfordítással.",
      "address": {
        "@@type": "PostalAddress",
        "streetAddress": "Kruspér utca 5-7. FSZ. 6.",
        "addressLocality": "Budapest",
        "postalCode": "1111",
        "addressCountry": "HU"
      },
      "telephone": "+36-20-921-5379"
    }
</script>

<!-- Rólam Section -->
<section id="rolam" class="section">
    <div class="container">
        <div class="d-flex flex-column flex-md-row align-items-center justify-content-start mb-5">
            <div class="text-center mb-3 mb-md-0">
                <img src="~/images/VaradiBorbasBrigitta.webp" class="img-fluid rounded-circle" alt="Váradi-Borbás Brigitta fényképe" style="max-width: 250px; border: 3px solid #F3EDE0;" />
            </div>
            <div class="ms-md-4 text-center text-md-start">
                <h2 class="section-title">Váradi-Borbás Brigitta</h2>
                <h3>Pszichológus és pszichológiai szakfordító</h3>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6 order-md-2">
                <img src="~/images/img1.webp" class="img-fluid" alt="Kép" />
            </div>
            <div class="col-md-6 order-md-1">
                <div style="font-family: forum, serif; font-size: 18px;">
                    <p class="fw-bold">Kedves Látogató!</p>
                    <p>Váradi-Borbás Brigitta, okleveles pszichológus és kognitív viselkedésterápiás (CBT) konzultáns jelölt vagyok. Tanulmányaimat a Maastrichti Egyetemen végeztem. Az egyetemi éveim alatt került hozzám közel a kognitív viselkedésterápiás szemlélet: olyan közegben tanulhattam, ahol a CBT-nek erős kutatási és gyakorlati hagyománya van, és ahol közelről láthattam, hogyan kapcsolódik össze a pszichológiai kutatás a terápiás munkával.</p>
                    <p>Később, a hódmezővásárhelyi EVP Egészségfejlesztési Irodában végzett munkám során tapasztaltam meg igazán, milyen sokféle nehézség esetén lehet hatékony ez a módszer. Különösen meggyőző volt számomra látni, hogy a közösen kitűzött célok mentén akár viszonylag rövid idő alatt is érzékelhető, kérdőívekkel is mérhető változás történhet. Ezért olyan terápiás munkában hiszek, amely egy elfogadó, biztonságos közegben egyszerre ad teret a megértésnek és segít abban, hogy konkrét változások is elinduljanak.</p>
                    <p>A kognitív viselkedésterápiában a gondolatok, érzelmek, testi reakciók és viselkedés összefüggéseit vizsgáljuk. A közös munka során feltérképezzük a nehézséget fenntartó mintázatokat, célokat fogalmazunk meg, és új gondolkodási módokat, viselkedéseket próbálunk ki. Célom, hogy a hozzám fordulók ne csak jobban értsék saját működésüket, hanem olyan eszközöket is elsajátítsanak, amelyeket később önállóan tudnak használni. Nem hiszek abban, hogy mindenkinek ugyanarra van szüksége: a módszereket mindig az adott emberhez és az aktuális problémához igazítom.</p>
                    <p>Különösen közel áll hozzám a szorongásos problémák és fóbiák kezelése, ezen belül kiemelt szakmai érdeklődési területem a hányástól való félelem, vagyis az emetofóbia.</p>
                    <p>Munkámat rendszeres szupervízió és önismereti munka kíséri. Fontos számomra, hogy a munkám egyszerre legyen emberközpontú és korszerű, bizonyítékokon alapuló szakmai ismeretekre épüljön, amely ismereteimet folyamatosan bővítem.</p>
                </div>
            </div>
        </div>

        <div class="mt-5" style="font-family: forum, serif; font-size: 18px;">
            <h2 class="section-title">Tanulmányok</h2>
            <ul class="list-unstyled">
                <li class="mb-3"><strong>Maastricht University</strong> – Research Master in Cognitive and Clinical Neuroscience, Specialization Clinical Psychology <span class="fst-italic">(okleveles pszichológus diplomaként a Magyar Ekvivalencia és Információs Központ által honosítva)</span></li>
                <li class="mb-3"><strong>Magyar Viselkedés-, Kognitív és Sématerápiás Egyesület (VIKOTE)</strong> – Kognitív viselkedésterápiás konzultáns <span class="fst-italic">(folyamatban)</span></li>
                <li class="mb-3"><strong>Magyar Viselkedés-, Kognitív és Sématerápiás Egyesület (VIKOTE)</strong> – Autogén tréning</li>
                <li class="mb-3"><strong>OH kártya instruktor</strong></li>
                <li class="mb-3"><strong>250+ óra önismeret</strong> – egyéni terápia és 150 óra csoportos, sématerápiás fókuszú önismeret</li>
                <li class="mb-3"><strong>Semmelweis Egyetem</strong> – Egészségtudományi szakfordító (angol–magyar)</li>
            </ul>
        </div>
    </div>
</section>

<!-- Szakterületeim Section -->
<section id="szakteruleteim" class="section">
    <div class="container">
        <div class="row">
            <div class="col-md-6">
                <img src="~/images/img2.webp" class="img-fluid" alt="Kép" />
            </div>
            <div class="col-md-6">
                <div style="font-family: forum, serif; font-size: 18px;">
                    <div class="text-center">
                        <h2 style="font-family: forum, serif;">Miben segíthetek?</h2>
                        <h6 style="font-family: forum, serif;">Egyéni pszichológiai konzultáció</h6>
                        <hr>
                    </div>
                    <ul class="list-unstyled" style="font-family: forum, serif; font-size: 18px;">
                        <li class="mb-2">Emetofóbia és más fóbiák kezelése</li>
                        <li class="mb-2">Stressz, szorongás</li>
                        <li class="mb-2">Túlzott aggódás, rágódás kezelése</li>
                        <li class="mb-2">Motiválatlanság, lehangoltság</li>
                        <li class="mb-2">Perfekcionizmus, önkritika, alacsony önbizalom</li>
                        <li class="mb-2">Halogatás, időgazdálkodási nehézségek</li>
                        <li class="mb-2">Szokások megváltoztatása</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Árak Section -->
<section id="arak" class="section">
    <div class="container">
        <div class="row">
            <div class="col-md-6 order-md-2">
                <img src="~/images/img3.webp" class="img-fluid" alt="Kép" />
            </div>
            <div class="col-md-6 order-md-1">
                <div class="text-center mb-4" style="font-family: forum, serif;">
                    <p class="fw-bold" style="font-size: 25px; font-style: italic;">Egyéni pszichológiai konzultáció</p>
                    <p style="font-size: 25px;">17.000 Ft/50 perc</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Kapcsolat Section -->
<section id="kapcsolat" class="section">
    <div class="container">
        <div class="row">
            <div class="col-md-6">
                <img src="~/images/img4.webp" class="img-fluid" alt="Kép" />
            </div>
            <div class="col-md-6">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success">@TempData["Success"]</div>
                }
                else
                {
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                }
                <div class="text-center mb-4">
                    <h2 style="font-size:26px; font-family: forum, serif;">Lépjen velem kapcsolatba</h2>
                    <hr>
                </div>
                <div style="font-size:16px;">
                    @*
                    <p class="fw-bold">Jelenleg nincs szabad kapacitásom. Ha szeretne értesítést kapni, amikor új helyek nyílnak emetofóbiával kapcsolatos konzultációra, az alábbi linken iratkozhat fel az értesítési listára: <a href="https://forms.gle/QN85wQ8m35TyqwUP9">https://forms.gle/QN85wQ8m35TyqwUP9</a></p>
                    *@
                    <p>Konzultációra online, illetve Budapest 11. kerületében van lehetőség</p>
                    <p><a href="mailto:varadiborbasbrigitta@gmail.com">varadiborbasbrigitta@gmail.com</a></p>
                    <p>Telefon: +36-20-921-5379</p>
                </div>
                <form asp-action="Contact" method="post">
                    @Html.AntiForgeryToken()
                    <div style="position:absolute; left:-10000px; top:auto; width:1px; height:1px; overflow:hidden;" aria-hidden="true">
                        <label asp-for="Website">Weboldal</label>
                        <input asp-for="Website" tabindex="-1" autocomplete="off" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" maxlength="100" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" maxlength="254" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Üzenet" class="form-label"></label>
                        <textarea asp-for="Üzenet" class="form-control" rows="5" maxlength="4000"></textarea>
                        <span asp-validation-for="Üzenet" class="text-danger"></span>
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" asp-for="AcceptPrivacyPolicy" required="required" data-val="true" data-val-required="Az adatkezelési nyilatkozat elfogadása kötelező." />
                        <label class="form-check-label" for="AcceptPrivacyPolicy">
                            Adatkezelési nyilatkozatot elolvastam és elfogadom. Megtekinthető
                            <a href="@Url.Action("DataUsage", "Home")">itt</a>.
                        </label>
                        <span asp-validation-for="AcceptPrivacyPolicy" class="text-danger"></span>
                    </div>
                    <button type="button" class="g-recaptcha btn btn-primary" data-sitekey="@recaptchaSiteKey" data-callback="onSubmit" data-action="submit">
                        Üzenet elküldése
                    </button>
                </form>
                <script nonce="@cspNonce">
                    function onSubmit(token) {
                        document.querySelector('form').submit();
                    }
                </script>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script nonce="@cspNonce">
        $(function () {
            $.validator.setDefaults({
                invalidHandler: function (event, validator) {
                    event.preventDefault();
                }
            });
        });
    </script>
}
