@{
    var cspNonce = Context.Items["CspNonce"] as string;
}
<!DOCTYPE html>
<html lang="hu">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Váradi-Borbás Brigitta</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-1BmE4kWBq78iYhFldvKuhfTAU6auU8tT94WrHftjDbrCEXSU1oBoqyl2QvZ6jIW3" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Forum&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
    <!-- Google tag (gtag.js) -->
    <script nonce="@cspNonce" async src="https://www.googletagmanager.com/gtag/js?id=AW-16889207419"></script>
    <script nonce="@cspNonce">
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());

        gtag('config', 'AW-16889207419');
    </script>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-light fixed-top">
            <div class="container">
                <a class="navbar-brand" href="@Url.Action("Index", "Home")">Váradi-Borbás Brigitta</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                        aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Index", "Home")#rolam">Rólam</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Index", "Home")#szakteruleteim">Szakterületeim</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Index", "Home")#arak">Árak</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Translation", "Home")">Pszichológiai szakfordítás</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Index", "Home")#kapcsolat">Kapcsolat</a>
                        </li>
                        @*
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Index", "Blog")">Blog</a>
                        </li>
                        *@
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="text-center py-3">
        &copy; @DateTime.Now.Year Váradi-Borbás Brigitta | <a href="@Url.Action("DataUsage", "Home")">Adatkezelési nyilatkozat</a>
    </footer>

    <!-- Include jQuery first -->
    <script nonce="@cspNonce" src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- Include Bootstrap JS -->
    <script nonce="@cspNonce" src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-ka7Sk0Gln4gmtz2MlQnikT1wXgYsOg+OMhuP+IlRH9sENBO0LRn5q+8nbTov4+1p" crossorigin="anonymous"></script>

    <!-- Smooth scrolling script -->
    <script nonce="@cspNonce">
        $(document).ready(function () {
            $('a.nav-link').click(function (e) {
                var href = $(this).attr('href');
                var currentUrl = window.location.href.split('#')[0];
                var targetUrl = href.split('#')[0];
                var targetHash = href.split('#')[1];

                if (currentUrl === targetUrl && targetHash) {
                    e.preventDefault();
                    var target = $('#' + targetHash);
                    if (target.length) {
                        $('html, body').animate({
                            scrollTop: target.offset().top
                        }, 600);
                    }
                }
            });
        });
    </script>

    <!-- Google Invisible reCAPTCHA -->
    <script nonce="@cspNonce" src="https://www.google.com/recaptcha/api.js" async defer></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
